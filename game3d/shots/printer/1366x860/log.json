{"lines":[{"node":"ticket","who":"mio","text":"Okay, your first repair request. I changed your screen to English, by ","left":null,"right":null},{"node":"ticket","who":null,"text":"REPAIR REQUEST #1. Copier, B2 copy room. Eats paper. Opened 1 April 19","left":{"who":"mio","face":"neutral","listen":true},"right":{"who":"eric","face":"surprised","listen":false}},{"node":"ticket","who":"eric","text":"Nineteen ninety-six?","left":{"who":"mio","face":"neutral","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"ticket","who":"mio","text":"Yeah. Mori-san opened it when he was new here, I think. Nobody closes ","left":{"who":"mio","face":"neutral","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"ticket","who":"mio","text":"森さん、{gaijin}にコピー機お願い。","left":{"who":"mori","face":"neutral","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"ticket","who":"mori","text":"外国の方、ですよ。","left":{"who":"mio","face":"embarrassed","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"ticket","who":"mio","text":"He says I should say gaikoku no kata. It's more polite. ...Anyway, go.","left":{"who":"mio","face":"embarrassed","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"copier","who":"mori","text":"また食べられました…","left":{"who":"mori","face":"flustered","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"copier","who":"mori","text":"{ugoite}.","left":{"who":"mori","face":"flustered","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"copier","who":null,"text":"He rolls his hands over each other, slowly, like winding up an old eng","left":{"who":"mori","face":"flustered","listen":false},"right":{"who":"eric","face":"neutral","listen":true}},{"node":"copier","who":"mori","text":"{ugoite}...","left":null,"right":{"who":"eric","face":"neutral","listen":false}},{"node":"copier","who":"mori","text":"…三十年。","left":{"who":"mori","face":"neutral","listen":false},"right":{"who":"eric","face":"neutral","listen":true}}],"nodes":[{"node":"ticket","t":314.7784000000073},{"node":"copier","t":325.12840000000904}],"copierEnd":343.3431999999645,"walks":[{"from":[2.155,-2.736],"to":[-2.961,4.195],"seconds":8.93,"pathLen":11.01,"straight":8.61,"maxStall":0.13,"stallAt":[-2.961,4.195,-3.701,2.12,324.81],"backtrack":0,"minGapToEric":2.2,"ericAt":[-3.701,2.12]},{"from":[-2.961,4.195],"to":[-2.961,4.195],"seconds":0.13,"pathLen":0,"straight":0,"maxStall":0.13,"stallAt":[-2.961,4.195,-5.412,3.406,327.61],"backtrack":0,"minGapToEric":2.57,"ericAt":[-5.412,3.406]},{"from":[-2.961,4.195],"to":[2.16,-3.36],"seconds":9.33,"pathLen":12.09,"straight":9.13,"maxStall":0.13,"stallAt":[-3.5,1.3,-5.412,3.406,343.343],"backtrack":0,"minGapToEric":1.28,"ericAt":[1.502,1.347]}],"errs":[],"track":[[314.811,2.16,-3.36,5.519,-1.536,"ticket",0,1],[315.612,2.16,-3.36,5.519,-1.536,"ticket",0,1],[316.411,1.853,-2.219,5.358,-1.276,"ticket",1,0],[317.211,1.174,-1.431,4.992,-0.33,"ticket",1,0],[318.012,0.495,-0.643,4.718,0.604,"ticket",1,0],[318.811,-0.183,0.144,3.895,1.139,"ticket",1,0],[319.611,-0.862,0.932,2.857,1.213,"ticket",1,0],[320.411,-1.72,1.336,1.82,1.286,"ticket",1,0],[321.21,-2.71,1.651,0.783,1.359,"ticket",1,0],[322.011,-3.65,1.95,-0.255,1.432,"ticket",1,0],[322.81,-4.141,2.745,-1.292,1.505,"ticket",1,0],[323.61,-4.15,3.72,-2.329,1.578,"ticket",1,0],[324.41,-3.244,4.082,-3.308,1.779,"ticket",1,0],[325.211,-2.961,4.195,-3.853,2.529,"ticket",0,1],[326.01,-2.961,4.195,-3.854,2.544,"ticket",0,1],[326.811,-2.961,4.195,-4.64,3.015,"copier",0,1],[327.61,-2.961,4.195,-5.412,3.406,"copier",0,1],[328.41,-2.961,4.195,-5.412,3.406,"copier",0,1],[329.211,-2.961,4.195,-5.412,3.406,"copier",0,1],[330.01,-2.961,4.195,-5.412,3.406,"copier",0,1],[330.83,-2.961,4.195,-5.412,3.406,"copier",0,1],[331.61,-2.961,4.195,-5.412,3.406,"copier",0,1],[332.41,-2.961,4.195,-5.412,3.406,"copier",0,1],[333.21,-2.961,4.195,-5.4