    "honsha",
    "本社"
   ],
   [
    "tsugiwa",
    "つぎは"
   ]
  ],
  "clear": [],
  "emo": "announcer"
 },
 {
  "key": "ln-1yjhwhw",
  "speaker": "mio",
  "text": "Oh, this is us. Go stand by the doors, it gets crowded. I'll pack up.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-15gwc80",
  "speaker": "mio",
  "text": "Doors, doors. I'm coming, I'm just packing the pickles.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-1im6xxm",
  "speaker": "mio",
  "text": "Ah, she's in the way... okay, one more. すみません. You use it for sorry too.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "sumimasen",
    "すみません"
   ]
  ],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-1eilv1d",
  "speaker": "mio",
  "text": "You'll get lost today, everybody does. Just say it and point at things. Honestly it works for almost everything.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "casual"
 },
