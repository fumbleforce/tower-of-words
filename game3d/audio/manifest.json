 },
 {
  "key": "ln-uf8chl",
  "speaker": "eric",
  "text": "Sea on both sides. Nobody said the island was this far out.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "tired"
 },
 {
  "key": "ln-sp6giw",
  "speaker": "mio",
  "text": "Ah... okay, I got it. Sorry.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-nz4t2",
  "speaker": "mio",
  "text": "Ah, sorry, sorry. Thank you. It's pickles. My mother thinks island has no food, so... every time I visit.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "flustered"
 },
 {
  "key": "ln-1tkjv3k",
  "speaker": "mio",
  "text": "...Okay. I think nothing broke. It's my mother's pickles.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-16kysq9",
  "speaker": "mio",
  "text": "Eh... B2? You're going to B2?",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "surprised"
 },
 {
  "key": "ln-nv21v1",
  "speaker": "eric",
  "text": "Yeah, IT support. I'm the contractor, it's my first day.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "tired"
 },
 {
  "key": "ln-1smowy6",
  "speaker": "mio",
  "text": "Ahh, you're the support contract? Mori-san said a 外人 is coming to help with the old machines. Amakawa never replaces anything, so, um... some of them are older than me.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "gaijin",
    "外人"
   ]
  ],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-m6bdio",
  "speaker": "eric",
  "text": "A what?",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "tired"
 },
 {
  "key": "ln-wzoz15",
  "speaker": "mio",
  "text": "Mm, like that. Don't worry, it's not mean, it's like saying “the new guy”. Only, you stay new guy for, um, maybe ten years.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "teasing"
 },
 {
  "key": "ln-1en4jir",
  "speaker": "mio",
  "text": "I'm Mio. I'm also B2, so... same team, I guess.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-1ag2vpj",
  "speaker": "mio",
  "text": "Mm, I know. It's on your card.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "deadpan"
 },
 {
  "key": "ln-zhdyny",
  "speaker": "mio",
  "text": "Mm. I stayed at her place last night, on the mainland. She always packs too much, like I'm moving to another country.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "fond"
 },
 {
  "key": "ln-1ryn3il",
  "speaker": "mio",
  "text": "Ne... sorry. Where are you from?",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-15pioie",
  "speaker": "eric",
  "text": "Norway.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "tired"
 },
 {
  "key": "ln-y9brzn",
  "speaker": "mio",
  "text": "Norway... okay. And Japanese? You speak it, like, at all?",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-5ykiwy",
  "speaker": "mio",
  "text": "Okay, arigatō is good. You'll use that one a lot.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-1l18x7q",
  "speaker": "mio",
  "text": "Ah... okay. Wow.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "deadpan"
 },
 {
  "key": "ln-p7h9ql",
  "speaker": "mio",
  "text": "You know it's all Amakawa people on the island, right? Nobody speaks English. Even at the supermarket.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-mr4c5a",
  "speaker": "mio",
  "text": "And Mori-san is going to be so polite with you, and you'll just stand there.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "amused"
 },
 {
  "key": "ln-ywlaq7",
  "speaker": "mio",
  "text": "えっと, okay. First one, おはようございます. You say it to everybody in the morning. The guard at the gate is really strict about it.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "ohayo",
    "おはようございます"
   ]
  ],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-nwr97u",
  "speaker": "mio",
  "text": "おはようございます...",
  "lang": "ja",
  "overheard": false,
  "words": [
   [
    "ohayo",
    "おはようございます"
   ]
  ],
  "clear": [],
  "emo": "slow",
  "slow": true
 },
 {
  "key": "ln-u7v3gq",
  "speaker": "mio",
  "text": "おはようございます. Mm, okay, not bad.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "ohayo",
    "おはようございます"
   ]
  ],
  "clear": [],
  "emo": "amused"
 },
 {
  "key": "ln-hviim",
  "speaker": "mio",
  "text": "Try the cat, over there. She kind of lives on this train, she won't judge you.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "amused"
 },
 {
  "key": "ln-7v53ll",
  "speaker": "mio",
  "text": "The cat. Go on, she won't bite.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "dry"
 },
 {
  "key": "ln-1wapqs5",
  "speaker": "mio",
  "text": "I heard it already. The cat.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "deadpan"
 },
 {
  "key": "ln-gs8qkh",
  "speaker": "mio",
  "text": "See? She's fine with it.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "amused"
 },
 {
  "key": "ln-nitaq3",
  "speaker": "mio",
  "text": "She's more awake than that guy, anyway. He's from the island too, Accounts I think. Every time he comes back from the mainland he sleeps the whole way, and one day he's going to miss our stop and go right back.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-1nbjpvk",
  "speaker": "mio",
  "text": "Anyway, when you meet someone new, it's よろしくおねがいします. Like “nice to meet you”, but more like “please be nice to me”.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "yoroshiku",
    "よろしくおねがいします"
   ]
  ],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-zihcn1",
  "speaker": "mio",
  "text": "よろしくおねがいします...",
  "lang": "ja",
  "overheard": false,
  "words": [
   [
    "yoroshiku",
    "よろしくおねがいします"
   ]
  ],
  "clear": [],
  "emo": "slow",
  "slow": true
 },
 {
  "key": "ln-dmvjy7",
  "speaker": "mio",
  "text": "よろしくおねがいします. Mm, good. Bow a little with Mori-san, he likes that.",
  "lang": "en",
  "overheard": false,
  "words": [
   [
    "yoroshiku",
    "よろしくおねがいします"
   ]
  ],
  "clear": [],
  "emo": "casual"
 },
 {
  "key": "ln-fylmwt",
  "speaker": "mio",
  "text": "Here, take a pickle. My mother made, like, way too many.",
  "lang": "en",
  "overheard": false,
  "words": [],
  "clear": [],
  "emo": "embarrassed"
 },
 {
  "key": "ln-1llfryn",
  "speaker": "ann",
