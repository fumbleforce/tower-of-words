{
  "name": "amakawa-tools",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node tools/check/run.mjs",
    "check:syntax": "node tools/check/syntax.mjs",
    "check:lint": "node tools/check/lint.mjs",
    "check:format": "node tools/check/format-runtime.mjs --check",
    "check:budgets": "node tools/check/module-budgets.mjs",
    "check:dependencies": "node tools/check/dependencies.mjs",
    "check:browser": "node tools/check/browser.mjs",
    "test": "node --test game3d/test/unit/*.test.mjs",
    "browser:install": "playwright install chromium",
    "check:routes": "node game3d/tools/fast-routes.mjs",
    "check:routes:day2": "node game3d/tools/fast-routes.mjs --day 2",
    "check:mc": "node game3d/tools/mc-check.mjs"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "espree": "11.2.0",
    "madge": "8.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  }
}
