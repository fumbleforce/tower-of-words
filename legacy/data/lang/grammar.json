{
  "about": "Grammar points in teaching order. Casual forms first, polite and keigo later (GUIDE: casual for the first half). Order follows the 12-week spine in game/notes/critique.md and the day-1 spell ladder in game/notes/day1-design.md. level = JLPT level where the point is usually taught. week = planned week of the 12-week probation. detect = true when tools/lang/annotate.py tags it automatically in lines.json.",
  "points": [
    {"id": "da", "order": 1, "week": 1, "level": 5, "name": "Casual copula だ", "pattern": "N + だ", "example": "新人だよ。", "en": "I'm the new guy.", "detect": true},
    {"id": "wa", "order": 2, "week": 1, "level": 5, "name": "Topic particle は", "pattern": "X は Y", "example": "私はエミ。", "en": "I'm Emi.", "detect": true},
