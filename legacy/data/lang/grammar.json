    {"id": "question", "order": 4, "week": 1, "level": 5, "name": "Casual question (rising tone)", "pattern": "…？", "example": "誰？", "en": "Who?", "detect": true},
    {"id": "ne", "order": 5, "week": 1, "level": 5, "name": "Sentence-end ね", "pattern": "…ね", "example": "まじめだね。", "en": "So serious, huh.", "detect": true},
    {"id": "yo", "order": 6, "week": 1, "level": 5, "name": "Sentence-end よ", "pattern": "…よ", "example": "こわいよ。", "en": "She's scary, you know.", "detect": true},
