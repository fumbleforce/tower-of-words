    {"id": "te-gu", "order": 9, "week": 1, "level": 5, "name": "te-form: ぐ → いで", "pattern": "急ぐ → 急いで", "example": "急いで。", "en": "Hurry.", "detect": true, "parent": "te-request"},
    {"id": "te-bu-mu-nu", "order": 10, "week": 1, "level": 5, "name": "te-form: ぶ/む/ぬ → んで", "pattern": "並ぶ → 並んで", "example": "並んで。", "en": "Line up.", "detect": true, "parent": "te-request"},
