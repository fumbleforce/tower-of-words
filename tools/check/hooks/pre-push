#!/bin/sh
# Refuse a push whose outgoing commits carry a secret (tools/check/secrets.sh: gitleaks plus the repo's rules).
# git gives one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
set -e
mkdir -p /tmp/claude-1000
cd "$(git rev-parse --show-toplevel)"
hooks=$(cd "$(dirname "$0")" && pwd)  # the scanner next to this hook, so it exists even in an older worktree
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch sends nothing
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$local_sha --not --remotes=$remote"  # a new branch, or a remote tip we don't have: everything not yet there
  fi
  bash "$hooks/../secrets.sh" range "$range" >/tmp/claude-1000/pre-push-secrets.$$ 2>&1 || status=$?
  if [ "$status" -ne 0 ]; then
    cat /tmp/claude-1000/pre-push-secrets.$$ >&2
    rm -f /tmp/claude-1000/pre-push-secrets.$$
    echo "pre-push: REFUSED push of $local_ref to $remote_ref: secret scan failed (status $status)" >&2
    exit 1
  fi
  tail -1 /tmp/claude-1000/pre-push-secrets.$$
  rm -f /tmp/claude-1000/pre-push-secrets.$$
done
exit 0
