{
 "about": "The live public assets: every file the game can load from game3d/assets, game3d/audio and game3d/fonts, and the code a release ships. Rules, fields and the tools: notes/asset-lifecycle.md. Change it with node tools/assets/live.mjs promote/retire; node tools/assets/live.mjs check proves the game matches it.",
 "roots": [
  "game3d/assets/",
  "game3d/audio/",
  "game3d/fonts/"
 ],
 "generated": "art/production/",
 "source": [
  "**/*.blend",
  "**/*.blend1",
  "**/check*.png",
  "**/check*.html",
  "**/*.md",
  "game3d/audio/manifest.json"
 ],
 "coarse": {
  "game3d/assets/**": "js/chibi.js playerBody: the protagonist's model folder, data/mc/<id>.json model.dir (each unit it can be names its loaded_by)",
  "game3d/assets/characters/": "js/mio.js CDIR, joined with a cast id in avatar.js and cast3d.js (each unit names its loaded_by)",
  "game3d/assets/portraits/*-*.webp": "js/ui/portraits.js; the faces are checked one by one from js/ui/portrait-data.js and data/mc",
  "game3d/assets/portraits/*-neutral.webp": "js/end.js; the faces are checked one by one from js/ui/portrait-data.js and data/mc",
  "game3d/assets/portraits/*.webp": "opening/paint.js, the live opening player",
  "game3d/audio/": "minigames/common/sound.js, a base for named clips",
  "game3d/audio/*.mp3": "js/audio/core.js: a voice clip by key, from game3d/audio/index.json"
 },
 "code": {
  "include": [
   "game3d/index.html",
   "game3d/build.json",
   "game3d/css/*.css",
   "game3d/vendor/**/*.js",
   "game3d/opening/**/*.{js,html}",
   "game3d/minigames/*.html",
   "game3d/minigames/*/*.{js,css}",
   "game3d/js/**/*.js",
   "game3d/story/**/*.js",
   "game3d/data/**/*.json",
   "game3d/audio/music/*.json"
  ],
  "not_scanned": [
   "game3d/vendor/**"
  ],
  "exclude": [
   "game3d/minigames/tools/**",
   "game3d/minigames/give-v1*",
   "game3d/minigames/give-v1/**",
   "game3d/js/shell-qa.js"
  ]
 },
