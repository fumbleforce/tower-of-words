    ["building", "Building parts", "Walls, windows, doors, canopies, roofs and whole building masses."],
    ["street", "Street furniture", "Benches, bins, bollards, signs, machines, rails and the nook kits."],
    ["planting", "Planting", "Trees, shrubs, hedges, grass and planters."],
    ["ground", "Ground", "Paving, kerbs, low walls, beds and floors."],
    ["lighting", "Lighting", "Lamps, light pools and the outdoor and room light rigs."],
    ["materials", "Materials and palettes", "The material cache, the shared colour palettes and the surface kinds look/ paints on."],
    ["interior", "Interior props", "Desks, chairs, shelves and the small things on them."],
    ["helpers", "Helpers", "The collectors, random numbers and geometry tools every piece is built with."]
  ],
