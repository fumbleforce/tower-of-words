# Ignore rules, by kind. A tracked file stays tracked whatever matches here: git ls-files is the record.
# Nested .gitignore files (tools/assets, tools/imagegen, game3d/tools/speech, ...) and .git/info/exclude still apply.

# Secrets and private material: never committed
.env
/contest/day2/.sealed-mapping
/island/PRIVATE.md
/island/private/

# Inter-agent inboxes, their long notes and the archive: local and size-limited (collab/PROTOCOL.md).
# Only the protocol file is tracked.
/collab/*
!/collab/PROTOCOL.md

# Worktrees and dependencies. node_modules has no trailing slash: agent worktrees link it to the main checkout's.
node_modules
/.claude/worktrees/

# Build output, caches, runtime locks and tool state
dist/
/tools/bin/
/tools/usage.json
/tools/voice-flags.txt
game3d/build.json
game3d/build.json.*.tmp
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.json.lock

# Generated outputs: tools/generated.json names each one and its builder. The tools rebuild them when missing, and git
# must not track them (npm run check fails on a tracked one).
/bible/data.json
/bible/showcase-dates.json
/tools/assets/assets.json

# Capture and output folders: one folder per run, kept on this machine
/game3d/shots/
/bible/shots/
/notes/feedback-game/2026-10-10_181035/
/notes/feedback-game/2026-10-10_181231/
/notes/feedback-game/2026-10-14_221423/

# Art work folders: pipeline state, logs, scripts and renders (notes/asset-storage-proposal.md lists them as local).
# Approved art lives in art/approved (listed there). art/parts keeps the files it already tracks.
/art/parts/
/art/production/
/art/company/
/art/opening/
/art/voice-raw/
/art/slice/
/art/video/
/art/music/
/art/candidates/**/*.log
# a character build's outputs (tools/characters/build.py): the recipe in tools/characters/recipes/ is the record
/art/candidates/*/*/src/
/art/candidates/*/*/meshy/
/art/candidates/*/*/build/
/game3d/assets/references/*.svg

# Binary media, archives and model weights: no binary is tracked anywhere (notes/asset-storage-proposal.md).
# Used assets sync with R2 through tools/assets/sync.py and tools/assets/assets.lock.json. The extensions are
# tools/assets/sync.json's binary_ext, in any case.
*.[wW][eE][bB][pP]
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
