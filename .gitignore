*.onnx
*.ONNX
*.bin
*.BIN
*.npy
*.NPY
*.npz
*.NPZ
*.pkl
*.PKL
*.pyc
*.PYC

# generated by game3d/tools/stamp.py whenever the game is served or loaded; never committed
game3d/build.json
game3d/build.json.*.tmp

# gitleaks, fetched by tools/check/secrets.sh
/tools/bin/

# the creator's Blender build outputs (tools/creator/blender/README.md); the GLBs are in the lock file
/art/parts/blender/*.json

# private channel for reward scenes (public repo)
/collab/private.md
collab/.post.lock

