*.OPUS
*.flac
*.FLAC
*.m4a
*.M4A
*.aac
*.AAC
*.mp4
*.MP4
*.webm
*.WEBM
*.mov
*.MOV
*.mkv
*.MKV
*.avi
*.AVI
*.glb
*.GLB
*.gltf
*.GLTF
*.fbx
*.FBX
*.obj
*.OBJ
*.blend
*.BLEND
*.blend1
*.BLEND1
*.vrm
*.VRM
*.ktx2
*.KTX2
*.basis
*.BASIS
*.woff
