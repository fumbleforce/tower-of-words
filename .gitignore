.env
# no trailing slash: agent worktrees have node_modules as a symlink to the main checkout's
node_modules
# agent worktrees (tools/worktree.sh, tools/land.sh)
/.claude/worktrees/
dist/
art/company/local2/
art/company/local/
art/music/
art/voice-raw/
art/slice/
legacy/proto2/llm/data/*.server.log
legacy/proto2/tts/raw/
art/company/local6/
art/production/
art/video/
art/opening/

# private reward pictures and dashboard data (local only), and the old island prototype's dev dependencies
island/private/
legacy/island/node_modules/

# Per-run automated QA artifacts (review assets remain retained separately)
game3d/shots/fast/
game3d/shots/crowd/
game3d/shots/routes/
game3d/shots/words-menu/
game3d/shots/prompts/
game3d/shots/chair/

# Local caches and runtime JSON locks. Dependency and asset lockfiles stay visible.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.json.lock

# No binary is tracked anywhere (notes/asset-storage-proposal.md). Used assets sync with R2 through
# tools/assets/sync.py and its lock file; everything else binary stays on this machine. The list is
# tools/assets/sync.json's binary_ext, in lower and upper case.
*.webp
*.WEBP
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.gif
*.GIF
*.avif
*.AVIF
*.bmp
*.BMP
